# Local development. Copy to `.env` (gitignored) and fill in your own keys.
# Never commit `.env`. Production and CI secrets do not belong here: they live
# in /opt/kith/.env on the VPS and in GitHub Actions secrets
# (see docs/deploy-quickstart.md).

# Embeddings and rerank (https://dash.voyageai.com). Without it, Search is
# keyword only and the ingest worker refuses to start.
VOYAGE_API_KEY=

# Answers for Ask (https://platform.openai.com/api-keys). Without it, every
# Ask answers 503.
OPENAI_API_KEY=

# Optional overrides for the local containers. The defaults in
# infra/docker-compose.yml are for local use only.
# POSTGRES_USER=kith
# POSTGRES_PASSWORD=<local-password>
# POSTGRES_DB=kith
# MINIO_ROOT_USER=<local-user>
# MINIO_ROOT_PASSWORD=<local-password>
# S3_BUCKET=kith-dev

# Frontend display flags ("false" turns them off).
# NEXT_PUBLIC_ASK_SHOW_SOURCES=true
# NEXT_PUBLIC_ASK_CITATION_MARKERS=true
